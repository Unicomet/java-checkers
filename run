#!/bin/sh
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$script_dir/run.ps1" "$@"
fi
if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$script_dir/run.ps1" "$@"
fi
echo "PowerShell (pwsh or powershell.exe) is required. Install it and retry." >&2
exit 1
