#!/bin/sh
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
if [ -x "$script_dir/java-checkers" ]; then
  bin=$script_dir/java-checkers
elif [ -x "$script_dir/target/release/java-checkers" ]; then
  bin=$script_dir/target/release/java-checkers
elif [ -x "$script_dir/target/debug/java-checkers" ]; then
  bin=$script_dir/target/debug/java-checkers
else
  echo "java-checkers binary is missing. From the checker checkout run: cargo build --release" >&2
  exit 1
fi
export JAVA_CHECKERS_QUALITY_ROOT="$script_dir"
exec "$bin" setup "$@"
