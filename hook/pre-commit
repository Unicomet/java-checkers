#!/bin/sh
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
if [ -n "$SKIP_LOCAL_CHECKS" ]; then
  echo "Skipping local Checkstyle, SpotBugs, and formatter."
  exit 0
fi
quality="$root/.local/quality"
if [ ! -x "$quality/java-checkers" ]; then
  echo "java-checkers binary is missing from $quality. Rebuild the checkers and run setup again." >&2
  exit 1
fi
export JAVA_CHECKERS_QUALITY_ROOT="$quality"
exec "$quality/java-checkers" run -PreCommit
