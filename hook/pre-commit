#!/bin/sh
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
if [ -n "$SKIP_LOCAL_CHECKS" ]; then
  echo "Skipping local Checkstyle, SpotBugs, and formatter."
  exit 0
fi
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File "$root/.local/quality/run.ps1" -PreCommit
  exit $?
fi
if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/.local/quality/run.ps1" -PreCommit
  exit $?
fi
echo "PowerShell (pwsh or powershell.exe) is required for local quality checks." >&2
exit 1
